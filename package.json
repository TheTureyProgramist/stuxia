  "scripts": {
    "dev": "vite",
    "build": "bun x vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backup": "powershell -Command \"$date = Get-Date -Format 'yyyy-MM-dd_HH-mm'; Get-ChildItem -Path './*' -Exclude 'node_modules', 'server', '.next', '.git', 'out', 'dist', '.env*' | Compress-Archive -DestinationPath ('../stykhiya-backup-' + $date + '.zip')\"",
    "predeploy": "node generate-deploy-id.js && bun run build",
    "deploy": "bun run build && bun x gh-pages -d dist -f --cname stuxia.com",
    "deploy:cpanel": "npm run build && node deploy.js",
    "test": "react-scripts test",
    "star": "node server/index.js"
  },
